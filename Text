let CriticalRiskExtensions = DeviceTvmBrowserExtensionsKB
    | where PermissionRisk contains "Critical"
    | where ExtensionRisk contains "Critical"
    | project ExtensionId, ExtensionName;
// Step 2: Get devices matching with those critical extension IDs in KB
let DevicesWithCriticalExtensions = DeviceTvmBrowserExtensions
    | where ExtensionId in (CriticalRiskExtensions)
    | project DeviceId, ExtensionId, ExtensionName
    | summarize CriticalExtensions = make_list(ExtensionId) by DeviceId, ExtensionName;
// Step 3: Join DeviceFileEvents with those devices and search for ExtensionId in FolderPath
