| mv-expand ExtensionId = CriticalExtensions
| extend ExtensionId = tostring(ExtensionId)
| where FolderPath contains ExtensionId
| summarize
    EventCount = count(),
    MatchingExtensions = make_set(ExtensionId),
    ExtensionName = make_set(ExtensionName),
    FolderPaths = make_set(FolderPath),
